# Calorithm — environment variables template.
# Copy to .env and fill in real values. Never commit .env to version control.
#
# Variables below are read by the application (core.config.Settings).
# Docker-compose also passes some compose-specific variables (POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB, API_PORT) — see the compose file comments.

# ---------------------------------------------------------------------------
# Application database connection (required)
# ---------------------------------------------------------------------------

# Full async SQLAlchemy URL for api-core (asyncpg driver).
# In docker-compose the host is the service name `postgres`:
#   postgresql+asyncpg://calorithm:changeme@postgres:5432/calorithm
# For local dev outside compose use `localhost` instead.
DATABASE_URL=postgresql+asyncpg://calorithm:changeme@localhost:5432/calorithm

# ---------------------------------------------------------------------------
# Application settings (optional — sensible defaults apply when omitted)
# ---------------------------------------------------------------------------

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Deployment environment tag: development | staging | production
APP_ENV=production
